{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 -B archive_deploy.py build",
  "outputDirectory": "public",
  "functions": {
    "api/archive-function.py": {
      "excludeFiles": "{!(api|vercel_runtime),!(api|vercel_runtime)/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/archive-function?route=:path"
    },
    {
      "source": "/archive-files",
      "destination": "/index.html"
    },
    {
      "source": "/archive-files/episodes",
      "destination": "/index.html"
    },
    {
      "source": "/episodes/:id",
      "destination": "/index.html"
    },
    {
      "source": "/episodes/:id/transcript",
      "destination": "/index.html"
    },
    {
      "source": "/episodes/:id/show-notes",
      "destination": "/index.html"
    },
    {
      "source": "/episodes/:id/file",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/downloads/catalogue.csv",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/csv; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"catalogue.csv\""
        }
      ]
    },
    {
      "source": "/downloads/episodes/:id.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\":id.md\""
        }
      ]
    },
    {
      "source": "/downloads/markdown-library.zip",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"tsse-markdown-library.zip\""
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
